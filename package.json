{
  "name": "dagobert",
  "version": "0.2.0",
  "description": "A DAG-shaped note-taking app",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "tauri": "tauri",
    "version": "node scripts/version.mjs",
    "test": "for f in tests/*.test.mjs; do node \"$f\" || exit 1; done && cargo test --manifest-path src-tauri/Cargo.toml",
    "install:app": "scripts/install.sh"
  },
  "license": "MIT",
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "dompurify": "^3",
    "marked": "^16",
    "phosphor-svelte": "^3.1.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tauri-apps/cli": "^2",
    "@tsconfig/svelte": "^5",
    "svelte": "^5.56.3",
    "svelte-check": "^4.6.0",
    "typescript": "~5.9",
    "vite": "^8.0.16"
  }
}
