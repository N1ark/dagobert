{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main",
    "note-*"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:allow-open",
    "core:webview:allow-create-webview-window",
    "core:window:allow-set-title",
    "core:window:allow-set-focus",
    "core:window:allow-close"
  ]
}